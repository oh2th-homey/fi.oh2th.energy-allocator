{
  "name": {
    "en": "Device Energy Allocation"
  },
  "class": "sensor",
  "capabilities": [
    "meter_power.total",
    "meter_power.grid",
    "measure_grid_share",
    "measure_self_sufficiency",
    "button.reset_meter"
  ],
  "capabilitiesOptions": {
    "meter_power.total": {
      "title": {
        "en": "Total energy"
      }
    },
    "meter_power.grid": {
      "title": {
        "en": "Grid energy"
      }
    },
    "meter_power.pv": {
      "title": {
        "en": "Solar energy"
      }
    },
    "meter_power.bat": {
      "title": {
        "en": "Battery energy"
      }
    },
    "button.reset_meter": {
      "maintenanceAction": true,
      "title": {
        "en": "Reset allocation meters"
      },
      "desc": {
        "en": "Set the total, grid, solar and battery energy counters back to zero."
      }
    }
  },
  "platforms": [
    "local"
  ],
  "images": {
    "small": "/drivers/device-allocation/assets/images/small.png",
    "large": "/drivers/device-allocation/assets/images/large.png",
    "xlarge": "/drivers/device-allocation/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "choose_mode",
      "navigation": {
        "next": "select_devices"
      }
    },
    {
      "id": "select_devices",
      "navigation": {
        "next": "select_counters"
      }
    },
    {
      "id": "select_counters"
    }
  ],
  "repair": [
    {
      "id": "select_devices",
      "navigation": {
        "next": "select_counters"
      }
    },
    {
      "id": "select_counters"
    }
  ]
}
