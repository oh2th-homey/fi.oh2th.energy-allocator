{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "fi.oh2th.energy-allocator",
  "version": "0.2.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "runtime": "nodejs",
  "brandColor": "#3B7A57",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Energy Allocator"
  },
  "description": {
    "en": "Estimate the split of grid, solar, and battery energy a device consumes."
  },
  "category": [
    "energy"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "api": {
    "getMeterDevices": {
      "method": "GET",
      "path": "/meterDevices"
    },
    "getConfig": {
      "method": "GET",
      "path": "/config"
    },
    "putConfig": {
      "method": "PUT",
      "path": "/config"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Tapio Heiskanen",
    "email": "oh2th@iki.fi"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "oh2th"
      },
      "githubSponsors": {
        "username": "oh2th"
      }
    }
  },
  "source": "https://github.com/oh2th/fi.oh2th.energy-allocator",
  "bugs": {
    "url": "https://github.com/oh2th/fi.oh2th.energy-allocator/issues"
  },
  "homeyCommunityTopicId": 159148,
  "support": "https://github.com/oh2th/fi.oh2th.energy-allocator/discussions/categories/general",
  "homepage": "https://oh2th.fi/tapio/homey/",
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Energy allocation changed"
        },
        "hint": {
          "en": "Trigger when the energy share changes by more than the configured number of percentage points."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=device-allocation|house-allocation"
          }
        ],
        "tokens": [
          {
            "name": "grid_share",
            "type": "number",
            "title": {
              "en": "Grid share (%)"
            },
            "example": 42
          },
          {
            "name": "self_sufficiency",
            "type": "number",
            "title": {
              "en": "Self-sufficiency (%)"
            },
            "example": 58
          }
        ],
        "id": "grid_share_changed"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Device Energy Allocation"
      },
      "class": "sensor",
      "capabilities": [
        "meter_power.total",
        "meter_power.grid",
        "measure_grid_share",
        "measure_self_sufficiency",
        "button.reset_meter"
      ],
      "capabilitiesOptions": {
        "meter_power.total": {
          "title": {
            "en": "Total energy"
          }
        },
        "meter_power.grid": {
          "title": {
            "en": "Grid energy"
          }
        },
        "meter_power.pv": {
          "title": {
            "en": "Solar energy"
          }
        },
        "meter_power.bat": {
          "title": {
            "en": "Battery energy"
          }
        },
        "button.reset_meter": {
          "maintenanceAction": true,
          "title": {
            "en": "Reset allocation meters"
          },
          "desc": {
            "en": "Set the total, grid, solar and battery energy counters back to zero."
          }
        }
      },
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/device-allocation/assets/images/small.png",
        "large": "/drivers/device-allocation/assets/images/large.png",
        "xlarge": "/drivers/device-allocation/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "choose_mode",
          "navigation": {
            "next": "select_devices"
          }
        },
        {
          "id": "select_devices",
          "navigation": {
            "next": "select_counters"
          }
        },
        {
          "id": "select_counters"
        }
      ],
      "repair": [
        {
          "id": "select_devices",
          "navigation": {
            "next": "select_counters"
          }
        },
        {
          "id": "select_counters"
        }
      ],
      "id": "device-allocation"
    },
    {
      "name": {
        "en": "House Energy Allocation"
      },
      "class": "sensor",
      "capabilities": [
        "meter_power.grid",
        "measure_grid_share",
        "measure_self_sufficiency",
        "button.reset_meter"
      ],
      "capabilitiesOptions": {
        "meter_power.grid": {
          "title": {
            "en": "Grid energy"
          }
        },
        "meter_power.pv": {
          "title": {
            "en": "Solar energy"
          }
        },
        "meter_power.bat": {
          "title": {
            "en": "Battery energy"
          }
        },
        "button.reset_meter": {
          "maintenanceAction": true,
          "title": {
            "en": "Reset allocation meters"
          },
          "desc": {
            "en": "Set the grid, solar and battery energy counters back to zero."
          }
        }
      },
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/house-allocation/assets/images/small.png",
        "large": "/drivers/house-allocation/assets/images/large.png",
        "xlarge": "/drivers/house-allocation/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "house-allocation"
    }
  ],
  "capabilities": {
    "measure_grid_share": {
      "type": "number",
      "title": {
        "en": "Grid usage"
      },
      "uiComponent": "sensor",
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "decimals": 1,
      "min": 0,
      "max": 100,
      "icon": "/assets/measure_grid_share.svg"
    },
    "measure_self_sufficiency": {
      "type": "number",
      "title": {
        "en": "Self-sufficiency"
      },
      "uiComponent": "sensor",
      "getable": true,
      "setable": false,
      "units": {
        "en": "%"
      },
      "decimals": 1,
      "min": 0,
      "max": 100,
      "icon": "/assets/measure_self_sufficiency.svg"
    }
  }
}